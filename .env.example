# =============================================================================
# The Field — environment configuration
# =============================================================================
# Copy to .env.local for development:   cp .env.example .env.local
#
# NEVER commit a file containing real values. .gitignore excludes .env* except
# this example (Doc 13 T-016, Doc 24 §O).
#
# In production these are set in the server environment / PM2 env, not in a
# file on disk (Doc 15 §6).
#
# Every variable marked REQUIRED is validated at startup. The process exits
# with a clear message if one is missing or malformed (Doc 22 M0-T07,
# Doc 23 REL-M1-T04, Doc 24 §I.4).
# =============================================================================

# ── Application ──────────────────────────────────────────────────────────────
# REQUIRED. One of: development | test | production
NODE_ENV=development
# Port for the primary application instance. The second PM2 instance uses
# PORT+1 (3001) — Doc 23 REL-M0-T01, Doc 24 §I.2.
PORT=3000
# REQUIRED in production. Absolute public origin, no trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Venue ────────────────────────────────────────────────────────────────────
# REQUIRED. UUID of the single venue row. Printed by `npm run db:seed`.
# Never a URL parameter or request field (Doc 10 §4.4, Doc 24 §M item 16).
VENUE_ID=
VENUE_SLUG=the-field

# ── Database ─────────────────────────────────────────────────────────────────
# Production/staging: managed PostgreSQL 16 (Doc 24 §D.1).
# Local development: docker compose up -d (see docker-compose.yml).
#
# REQUIRED. Runtime connection — app_user. Cannot DELETE bookings/payments/
# proofs and cannot UPDATE/DELETE audit_logs (Doc 05 §9, Doc 22 §4.4).
DATABASE_URL=postgresql://app_user:localdev@127.0.0.1:5432/thefield
# Used only by migrations and seeds — migration_user.
DATABASE_MIGRATION_URL=postgresql://postgres:localdev@127.0.0.1:5432/thefield
# Used only by the backup script — backup_user, SELECT only (Doc 21 DF-004).
DATABASE_BACKUP_URL=
# Connection pool, per instance. 2 instances x 10 = 20 (Doc 23 §2.4).
DB_POOL_MAX=10
DB_POOL_MIN=2

# ── Sessions ─────────────────────────────────────────────────────────────────
# REQUIRED. Minimum 32 characters. Generate with: openssl rand -hex 64
# Must be IDENTICAL across all application instances so a session issued by one
# instance is valid on the other (Doc 23 §11.3, REL-M1-T02).
# Rotating it logs out every admin and customer — this is the emergency
# revocation control (Doc 10 §2.4).
SESSION_SECRET=

# ── Google Sign-In (customer authentication — implemented in Milestone 1) ────
# Doc 24 §E.2. Implemented with `arctic` + iron-session. No NextAuth, no Lucia.
# Required once Milestone 1 lands; unused in Milestone 0.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must exactly match the URI registered in the Google Cloud console. A single
# fixed value — never reflected from a request (Doc 23 §16.4).
GOOGLE_REDIRECT_URI=http://localhost:3000/api/v1/auth/google/callback

# ── Storage ──────────────────────────────────────────────────────────────────
# REQUIRED. 's3' (Cloudflare R2) or 'local'.
# 'local' is DEVELOPMENT ONLY. Production must be 's3' — no persistent files on
# the VPS disk (Doc 23 §1.3, §16.6; Doc 24 §H.1).
STORAGE_PROVIDER=local
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Private bucket — payment proofs. No public access policy (Doc 12 §4.3).
S3_PRIVATE_BUCKET=
# Public bucket — gallery, court and CMS media.
S3_PUBLIC_BUCKET=
S3_PUBLIC_BASE_URL=
# Local fallback (development only)
LOCAL_STORAGE_PATH=./storage
LOCAL_STORAGE_PUBLIC_URL=http://localhost:3000/media

# ── Booking engine ───────────────────────────────────────────────────────────
# REQUIRED — and deliberately has NO DEFAULT.
#
# OBD-002 IS UNRESOLVED. This is a business policy decision that only the venue
# owner can make: how long is a court slot held for a customer who has not
# uploaded payment proof? The application refuses to start until it is set, on
# every environment, so that no invented value can reach production
# (Doc 22 Preamble #4 and §4.6, Doc 23 §13.8 rule 8, Doc 24 §I.4).
#
# For local development set any throwaway value (e.g. 120). That value carries
# no business meaning and must never be copied to staging or production.
BOOKING_EXPIRY_MINUTES=
# How often the expiry job runs. Both application instances run it; the atomic
# UPDATE makes that safe (Doc 23 §1.4, Doc 24 §I.2).
BOOKING_EXPIRY_JOB_INTERVAL_MINUTES=15

# ── Observability ────────────────────────────────────────────────────────────
# trace | debug | info | warn | error | fatal
LOG_LEVEL=info
# Milliseconds to keep serving in-flight requests after SIGTERM before closing
# the pool. Production uses 30000 with PM2 kill_timeout 35000 (Doc 23 §13.5).
# Development defaults to 0 so restarts are instant.
SHUTDOWN_DRAIN_MS=
# Sentry is wired in a later milestone (Doc 22 M0-T11). The capture seam exists
# in src/lib/observability.ts; leaving this blank disables reporting.
SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_CRON_MONITOR_ID=

# ── Operations ───────────────────────────────────────────────────────────────
# Optional. Backup failure alerting (Doc 23 §7.2). Email fallback if unset.
SLACK_WEBHOOK_URL=

# ── Seed (initial deployment only) ───────────────────────────────────────────
# Consumed once by `npm run db:seed`, then removed from the environment.
# The seeded administrator must change this password on first login
# (must_change_password = true — Doc 21 RC-007b).
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
